msgid ""
"For instructions, see the Ventoy documentation: [Start to use Ventoy]"
"(https://www.ventoy.net/en/doc_start.html)."
msgstr ""

#: ../../../how-to/create-a-bootable-usb-stick.md:435
msgid "Ventoy is available for Linux and Microsoft Windows."
msgstr ""

#: ../../../how-to/create-a-bootable-usb-stick.md:438
msgid ""
