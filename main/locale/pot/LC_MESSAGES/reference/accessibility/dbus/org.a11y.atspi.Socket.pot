msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Socket.md:29
msgid ""
"The registry sets the \\\"Id\\\" property on the org.a11y.atspi.Application "
"interface on the `plug` object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Socket.md:31
msgid ""
"The Embed method returns with the bus name and object path for the "
"registry\\'s root object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Socket.md:34
msgid "Returns: the bus name and object path of the registry\\'s root object."
