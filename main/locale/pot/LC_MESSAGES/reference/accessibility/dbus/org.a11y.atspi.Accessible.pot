#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:2
msgid "org.a11y.atspi.Accessible"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:4
msgid "Description"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:6
msgid ""
"Base interface that defines basic information about the object, where in the "
"object hierarchy it is located, relations and additional interfaces."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:8
msgid "Is implemented by all accessible objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:10
msgid "Properties"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:12
msgid "org.a11y.atspi.Accessible:Name"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:14
msgid "Name readable s\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:16
msgid ""
"Human-readable, localized, short name for the object. Normally you need to "
"set this for objects which do not have a labelled-by relation. Consider a "
"widget to select RGB colors by setting three sliders. The names for the "
"sliders would be \\\"Red\\\", \\\"Green\\\", \\\"Blue\\\", respectively, or "
"translations to application\\'s locale. The names would be unnecessary if "
"each slider had a labelled-by relation to corresponding labels visible in "
"the user interface."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:24
msgid ""
"In general, something is missing from your application if an object that can "
"be interacted with has no Name or a labelled-by relation."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:27
msgid "org.a11y.atspi.Accessible:Description"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:29
msgid "Description readable s\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:31
msgid ""
"Human-readable, localized description of the object in more detail. While "
"the Name property is meant to be a short string that screen readers say "
"during normal navigation, the Description property is for when the user asks "
"for more detail."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:36
msgid "org.a11y.atspi.Accessible:Parent"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:38
msgid "Parent readable (so)\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:40
msgid ""
"Accessible parent object of the current object. The (so) is a string for the "
"application name, and an object path."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:43
msgid ""
"Null parent: If the object has no parent (e.g. the application\\'s root "
"object is being queried), return \\\"\\\" for the application name name and "
"\\\"/org/a11y/atspi/null\\\" for the object path."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:47
msgid ""
"Root object: An application must have a single root object, called \\\"/org/"
"a11y/atspi/accessible/root\\\". All other objects should have that one as "
"their highest-level ancestor."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:51
msgid "org.a11y.atspi.Accessible:ChildCount"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:55
msgid "ChildCount readable i\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:57
msgid "number of accessible children for this object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:59
msgid "org.a11y.atspi.Accessible:Locale"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:63
msgid "Locale readable s\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:67
msgid ""
"Unix locale for the current object. For an application, this may be the "
"locale for the language that the application shows in its user interface."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:71
msgid ""
"For a document being shown in an application, or a paragraph within a "
"document, the locale may refer to that object exclusively. For example, an "
"application may be showing itself in English (\\\"en\\\"), but it may be "
"used to display a document in Spanish (\\\"es\\\"). In the latter case, a "
"screen reader will want to know that it should switch to Spanish while "
"reading the document."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:78
msgid "org.a11y.atspi.Accessible:AccessibleId"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:82
msgid "AccessibleId readable s\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:86
msgid ""
"Application-specific identifier for the current object. This can be used to "
"give a special id to an object for reliable identification by ATs or for use "
"in tests, for example, \\\"my_widget\\\". Note that there is no way to "
"directly find an object by its id; ATs may have to recursively get the "
"children to find a specific id. This is because accessible objects can be "
"created dynamically, and they do not always correspond to a static view of "
"an application\\'s data."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:94
msgid "org.a11y.atspi.Accessible:HelpText"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:98
msgid "HelpText readable s\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:102
msgid "Help text for the current object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:104
msgid "Methods"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:106
msgid "org.a11y.atspi.Accessible.GetChildAtIndex"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:110
msgid ""
"GetChildAtIndex (\n"
"  IN index i,\n"
"  OUT unnamed_arg1 (so)\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:117
msgid ""
"Queries the Nth accessible child of the current object. It is expected that "
"this will correspond to the order that the GetChildren method would return."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:123
msgid "The (so) is a string for the application name, and an object path."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:126
msgid ""
"Notes: implementations vary in their behavior when the index is out of "
"range. GTK4 returns an error, while atk-adaptor returns the null object path "
"\\\"/org/a11y/atspi/null\\\". To keep the type system gods happy, you should "
"probably return a DBus error in that case."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:131
msgid "index"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:133
msgid "0-based index of the child to query."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:135
msgid "unnamed_arg1"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:137
msgid "org.a11y.atspi.Accessible.GetChildren"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:141
msgid ""
"GetChildren (\n"
"  OUT unnamed_arg0 a(so)\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:147
msgid "Returns a list of the object\\'s accessible children."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:149
msgid ""
"Each array element (so) is a string for the application name, and an object "
"path."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:152
msgid ""
"An implementor may return an error if the object exposes a large number of "
"children such that returning a list would be prohibitive."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:156
msgid "org.a11y.atspi.Accessible.GetIndexInParent"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:160
msgid ""
"GetIndexInParent (\n"
"  OUT unnamed_arg0 i\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:166
msgid ""
"Returns the 0-based index at which the object would be returned by calling "
"GetChildren on its parent, or -1 if the object has no containing parent or "
"on exception."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:171
msgid "org.a11y.atspi.Accessible.GetRelationSet"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:175
msgid ""
"GetRelationSet (\n"
"  OUT unnamed_arg0 a(ua(so))\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:181
msgid ""
"Returns a set of relationships between the current object and others. Each "
"element in the outermost array contains a number that indicates the relation "
"type (see below), and an array of references to accessible objects to which "
"that relationship applies. Each element in the inner array is a (so) with a "
"string for the application name, and an object path."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:188
msgid ""
"Each relationship between objects (possibly one-to-many or many-to-one) "
"allows better semantic identification of how objects are associated with one "
"another. For instance, the ATSPI_RELATION_LABELLED_BY relationship may be "
"used to identify labelling information that should accompany the accessible "
"name property when presenting an object\\'s content or identity to the end "
"user. Similarly, ATSPI_RELATION_CONTROLLER_FOR can be used to further "
"specify the context in which a valuator is useful, and/or the other UI "
"components which are directly effected by user interactions with the "
"valuator. Common examples include association of scrollbars with the "
"viewport or panel which they control."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:201
msgid ""
"Relation types - these are the enum values from AtspiRelationType in atspi-"
"constants.h:"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:204
msgid ""
"0 - ATSPI_RELATION_NULL: Not a meaningful relationship; clients should not"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:206
msgid "normally encounter this value."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:208
msgid ""
"1 - ATSPI_RELATION_LABEL_FOR: Object is a label for one or more other "
"objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:211
msgid "2 - ATSPI_RELATION_LABELLED_BY: Object is labelled by one or more other"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:213
msgid "objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:215
msgid ""
"3 - ATSPI_RELATION_CONTROLLER_FOR: Object is an interactive object which"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:217
msgid ""
"modifies the state, onscreen location, or other attributes of one or   more "
"target objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:220
msgid "4 - ATSPI_RELATION_CONTROLLED_BY: Object state, position, etc. is"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:222
msgid ""
"modified/controlled by user interaction with one or more other   objects. "
"For instance a viewport or scroll pane may be   ATSPI_RELATION_CONTROLLED_BY "
"scrollbars."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:226
msgid ""
"5 - ATSPI_RELATION_MEMBER_OF: Object has a grouping relationship (e.g. "
"\\'same"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:228
msgid "group as\\') to one or more other objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:230
msgid ""
"6 - ATSPI_RELATION_TOOLTIP_FOR: Object is a tooltip associated with another"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:232
#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:607
#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1030
msgid "object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:234
msgid "7 - ATSPI_RELATION_NODE_CHILD_OF: Object is a child of the target."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:236
msgid "8 - ATSPI_RELATION_NODE_PARENT_OF: Object is a parent of the target."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:238
msgid ""
"9 - ATSPI_RELATION_EXTENDED: Used to indicate that a relationship exists, but"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:240
msgid "its type is not specified in the enumeration."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:242
msgid ""
"10 - ATSPI_RELATION_FLOWS_TO: Object renders content which flows logically to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:244
msgid ""
"another object. For instance, text in a paragraph may flow to   another "
"object which is not the \\'next sibling\\' in the   accessibility hierarchy."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:248
msgid "11 - ATSPI_RELATION_FLOWS_FROM: Reciprocal of ATSPI_RELATION_FLOWS_TO."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:250
msgid ""
"12 - ATSPI_RELATION_SUBWINDOW_OF: Object is visually and semantically "
"considered"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:252
msgid ""
"a subwindow of another object, even though it is not the object\\'s   child. "
"Useful when dealing with embedded applications and other   cases where the "
"widget hierarchy does not map cleanly to the   onscreen presentation."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:257
msgid "13 - ATSPI_RELATION_EMBEDS: Similar to ATSPI_RELATION_SUBWINDOW_OF, but"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:259
msgid "specifically used for cross-process embedding."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:261
msgid ""
"14 - ATSPI_RELATION_EMBEDDED_BY: Reciprocal of ATSPI_RELATION_EMBEDS. Used to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:263
msgid ""
"denote content rendered by embedded renderers that live in a   separate "
"process space from the embedding context."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:266
msgid ""
"15 - ATSPI_RELATION_POPUP_FOR: Denotes that the object is a transient window "
"or"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:268
msgid ""
"frame associated with another onscreen object. Similar to   "
"ATSPI_TOOLTIP_FOR, but more general. Useful for windows which are   "
"technically toplevels but which, for one or more reasons, do not   "
"explicitly cause their associated window to lose \\'window focus\\'.   "
"Creation of an ATSPI_ROLE_WINDOW object with the   ATSPI_RELATION_POPUP_FOR "
"relation usually requires some presentation   action on the part of "
"assistive technology clients, even though the   previous toplevel "
"ATSPI_ROLE_FRAME object may still be the active   window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:278
msgid ""
"16 - ATSPI_RELATION_PARENT_WINDOW_OF: This is the reciprocal relation to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:280
msgid "ATSPI_RELATION_POPUP_FOR."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:282
msgid ""
"17 - ATSPI_RELATION_DESCRIPTION_FOR: Reciprocal of "
"ATSPI_RELATION_DESCRIBED_BY."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:284
msgid ""
"Indicates that this object provides descriptive information about   the "
"target object(s). See also ATSPI_RELATION_DETAILS_FOR and   "
"ATSPI_RELATION_ERROR_FOR."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:288
msgid ""
"18 - ATSPI_RELATION_DESCRIBED_BY: Reciprocal of "
"ATSPI_RELATION_DESCRIPTION_FOR."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:290
msgid ""
"Indicates that one or more target objects provide descriptive   information "
"about this object. This relation type is most   appropriate for information "
"that is not essential as its   presentation may be user-configurable and/or "
"limited to an on-demand   mechanism such as an assistive technology command. "
"For brief,   essential information such as can be found in a widget\\'s on-"
"screen   label, use ATSPI_RELATION_LABELLED_BY. For an on-screen error   "
"message, use ATSPI_RELATION_ERROR_MESSAGE. For lengthy extended   "
"descriptive information contained in an on-screen object, consider   using "
"ATSPI_RELATION_DETAILS as assistive technologies may provide a   means for "
"the user to navigate to objects containing detailed   descriptions so that "
"their content can be more closely reviewed."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:303
msgid ""
"19 - ATSPI_RELATION_DETAILS: Reciprocal of ATSPI_RELATION_DETAILS_FOR. "
"Indicates"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:305
msgid ""
"that this object has a detailed or extended description, the   contents of "
"which can be found in the target object(s). This   relation type is most "
"appropriate for information that is   sufficiently lengthy as to make "
"navigation to the container of that   information desirable. For less "
"verbose information suitable for   announcement only, see "
"ATSPI_RELATION_DESCRIBED_BY. If the detailed   information describes an "
"error condition, ATSPI_RELATION_ERROR_FOR   should be used instead. Since "
"2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:314
msgid ""
"20 - ATSPI_RELATION_DETAILS_FOR: Reciprocal of ATSPI_RELATION_DETAILS. "
"Indicates"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:316
msgid ""
"that this object provides a detailed or extended description about   the "
"target object(s). See also ATSPI_RELATION_DESCRIPTION_FOR and   "
"ATSPI_RELATION_ERROR_FOR. Since 2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:320
msgid ""
"21 - ATSPI_RELATION_ERROR_MESSAGE: Reciprocal of ATSPI_RELATION_ERROR_FOR."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:322
msgid ""
"Indicates that this object has one or more errors, the nature of   which is "
"described in the contents of the target object(s). Objects   that have this "
"relation type should also contain   ATSPI_STATE_INVALID_ENTRY when their "
"GetState method is called.   Since: 2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:328
msgid ""
"22 - ATSPI_RELATION_ERROR_FOR: Reciprocal of ATSPI_RELATION_ERROR_MESSAGE."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:330
msgid ""
"Indicates that this object contains an error message describing an   invalid "
"condition in the target object(s). Since: 2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:334
msgid "org.a11y.atspi.Accessible.GetRole"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:338
msgid ""
"GetRole (\n"
"  OUT unnamed_arg0 u\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:344
msgid ""
"Gets the accessible role that the current object represents. Roles make it "
"possible for various UI toolkits to expose their controls to assistive "
"technologies (ATs) with a standard interface, regardless of toolkit. For "
"example, a widget that acts like a conventional push button (appears "
"unpressed; presses when acted upon; invokes a certain action when pressed) "
"can expose an ATSPI_ROLE_BUTTON role."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:353
msgid ""
"Role values - these are the enum values from AtspiRole in atspi-constants.h:"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:356
msgid "0 - ATSPI_ROLE_INVALID: A role indicating an error condition, such as"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:358
msgid "uninitialized Role data."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:360
msgid ""
"1 - ATSPI_ROLE_ACCELERATOR_LABEL: Object is a label indicating the keyboard"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:362
msgid "accelerators for the parent."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:364
msgid "2 - ATSPI_ROLE_ALERT: Object is used to alert the user about something."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:366
msgid ""
"3 - ATSPI_ROLE_ANIMATION: Object contains a dynamic or moving image of some"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:368
msgid "kind."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:370
msgid "4 - ATSPI_ROLE_ARROW: Object is a 2D directional indicator."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:372
msgid ""
"5 - ATSPI_ROLE_CALENDAR: Object contains one or more dates, usually arranged"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:374
msgid "into a 2D list."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:376
msgid ""
"6 - ATSPI_ROLE_CANVAS: Object that can be drawn into and is used to trap"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:378
msgid "events."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:380
msgid "7 - ATSPI_ROLE_CHECK_BOX: A choice that can be checked or unchecked and"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:382
msgid "provides a separate indicator for the current state."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:384
msgid ""
"8 - ATSPI_ROLE_CHECK_MENU_ITEM: A menu item that behaves like a check box. "
"See"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:386
msgid "ATSPI_ROLE_CHECK_BOX."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:388
msgid ""
"9 - ATSPI_ROLE_COLOR_CHOOSER: A specialized dialog that lets the user choose "
"a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:390
msgid "color."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:392
msgid "10 - ATSPI_ROLE_COLUMN_HEADER: The header for a column of data."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:394
msgid "11 - ATSPI_ROLE_COMBO_BOX: A list of choices the user can select from."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:396
msgid "12 - ATSPI_ROLE_DATE_EDITOR: An object which allows entry of a date."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:398
msgid ""
"13 - ATSPI_ROLE_DESKTOP_ICON: An inconified internal frame within a "
"DESKTOP_PANE."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:401
msgid "14 - ATSPI_ROLE_DESKTOP_FRAME: A pane that supports internal frames and"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:403
msgid "iconified versions of those internal frames."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:405
msgid ""
"15 - ATSPI_ROLE_DIAL: An object that allows a value to be changed via "
"rotating a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:407
msgid ""
"visual element, or which displays a value via such a rotating   element."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:410
msgid "16 - ATSPI_ROLE_DIALOG: A top level window with title bar and a border."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:412
msgid ""
"17 - ATSPI_ROLE_DIRECTORY_PANE: A pane that allows the user to navigate "
"through"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:414
msgid "and select the contents of a directory."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:416
msgid ""
"18 - ATSPI_ROLE_DRAWING_AREA: An object used for drawing custom user "
"interface"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:418
msgid "elements."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:420
msgid ""
"19 - ATSPI_ROLE_FILE_CHOOSER: A specialized dialog that displays the files in"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:422
msgid ""
"the directory and lets the user select a file, browse a different   "
"directory, or specify a filename."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:425
msgid ""
"20 - ATSPI_ROLE_FILLER: A object that fills up space in a user interface."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:428
msgid ""
"21 - ATSPI_ROLE_FOCUS_TRAVERSABLE: Don\\'t use, reserved for future use."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:430
msgid "22 - ATSPI_ROLE_FONT_CHOOSER: Allows selection of a display font."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:432
msgid ""
"23 - ATSPI_ROLE_FRAME: A top level window with a title bar, border, menubar,"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:434
msgid "etc."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:436
msgid ""
"24 - ATSPI_ROLE_GLASS_PANE: A pane that is guaranteed to be painted on top of"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:438
msgid "all panes beneath it."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:440
msgid ""
"25 - ATSPI_ROLE_HTML_CONTAINER: A document container for HTML, whose children"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:442
msgid "represent the document content."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:444
msgid ""
"26 - ATSPI_ROLE_ICON: A small fixed size picture, typically used to decorate"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:446
msgid "components."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:448
msgid "27 - ATSPI_ROLE_IMAGE: An image, typically static."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:450
msgid ""
"28 - ATSPI_ROLE_INTERNAL_FRAME: A frame-like object that is clipped by a "
"desktop"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:452
msgid "pane."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:454
msgid ""
"29 - ATSPI_ROLE_LABEL: An object used to present an icon or short string in "
"an"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:456
msgid "interface."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:458
msgid ""
"30 - ATSPI_ROLE_LAYERED_PANE: A specialized pane that allows its children to "
"be"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:460
msgid "drawn in layers, providing a form of stacking order."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:462
msgid ""
"31 - ATSPI_ROLE_LIST: An object that presents a list of objects to the user "
"and"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:464
msgid "allows the user to select one or more of them."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:466
msgid ""
"32 - ATSPI_ROLE_LIST_ITEM: An object that represents an element of a list."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:469
msgid ""
"33 - ATSPI_ROLE_MENU: An object usually found inside a menu bar that "
"contains a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:471
msgid "list of actions the user can choose from."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:473
msgid ""
"34 - ATSPI_ROLE_MENU_BAR: An object usually drawn at the top of the primary"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:475
msgid ""
"dialog box of an application that contains a list of menus the user   can "
"choose from."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:478
msgid ""
"35 - ATSPI_ROLE_MENU_ITEM: An object usually contained in a menu that "
"presents"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:480
msgid "an action the user can choose."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:482
msgid ""
"36 - ATSPI_ROLE_OPTION_PANE: A specialized pane whose primary use is inside a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:484
msgid "dialog."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:486
msgid "37 - ATSPI_ROLE_PAGE_TAB: An object that is a child of a page tab list."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:488
msgid ""
"38 - ATSPI_ROLE_PAGE_TAB_LIST: An object that presents a series of panels (or"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:490
msgid ""
"page tabs), one at a time,through some mechanism provided by the   object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:493
msgid ""
"39 - ATSPI_ROLE_PANEL: A generic container that is often used to group "
"objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:496
msgid ""
"40 - ATSPI_ROLE_PASSWORD_TEXT: A text object uses for passwords, or other "
"places"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:498
msgid "where the text content is not shown visibly to the user."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:500
msgid ""
"41 - ATSPI_ROLE_POPUP_MENU: A temporary window that is usually used to offer "
"the"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:502
msgid ""
"user a list of choices, and then hides when the user selects one of   those "
"choices."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:505
msgid ""
"42 - ATSPI_ROLE_PROGRESS_BAR: An object used to indicate how much of a task "
"has"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:507
msgid "been completed."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:509
msgid "43 - ATSPI_ROLE_BUTTON: An object the user can manipulate to tell the"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:511
msgid "application to do something."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:513
msgid ""
"44 - ATSPI_ROLE_RADIO_BUTTON: A specialized check box that will cause other"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:515
msgid ""
"radio buttons in the same group to become unchecked when this one is   "
"checked."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:518
msgid ""
"45 - ATSPI_ROLE_RADIO_MENU_ITEM: Object is both a menu item and a \\\"radio "
"button\\\"."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:520
msgid "See ATSPI_ROLE_RADIO_BUTTON."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:522
msgid ""
"46 - ATSPI_ROLE_ROOT_PANE: A specialized pane that has a glass pane and a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:524
msgid "layered pane as its children."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:526
msgid "47 - ATSPI_ROLE_ROW_HEADER: The header for a row of data."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:528
msgid "48 - ATSPI_ROLE_SCROLL_BAR: An object usually used to allow a user to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:530
msgid ""
"incrementally view a large amount of data by moving the bounds of a   "
"viewport along a one-dimensional axis."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:533
msgid ""
"49 - ATSPI_ROLE_SCROLL_PANE: An object that allows a user to incrementally "
"view"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:535
msgid ""
"a large amount of information. Scroll pane objects are usually   accompanied "
"by ATSPI_ROLE_SCROLL_BAR controllers, on which the   "
"ATSPI_RELATION_CONTROLLER_FOR and ATSPI_RELATION_CONTROLLED_BY   reciprocal "
"relations are set. See the GetRelationSet method."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:540
msgid ""
"50 - ATSPI_ROLE_SEPARATOR: An object usually contained in a menu to provide a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:542
msgid "visible and logical separation of the contents in a menu."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:544
msgid ""
"51 - ATSPI_ROLE_SLIDER: An object that allows the user to select from a "
"bounded range."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:546
msgid ""
"Unlike ATSPI_ROLE_SCROLL_BAR, ATSPI_ROLE_SLIDER objects need not   control "
"\\'viewport\\'-like objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:549
msgid ""
"52 - ATSPI_ROLE_SPIN_BUTTON: An object which allows one of a set of choices "
"to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:551
msgid "be selected, and which displays the current choice."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:553
msgid ""
"53 - ATSPI_ROLE_SPLIT_PANE: A specialized panel that presents two other "
"panels"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:555
msgid "at the same time."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:557
msgid ""
"54 - ATSPI_ROLE_STATUS_BAR: Object displays non-quantitative status "
"information"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:559
msgid "(c.f. ATSPI_ROLE_PROGRESS_BAR)"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:561
msgid ""
"55 - ATSPI_ROLE_TABLE: An object used to represent information in terms of "
"rows"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:563
msgid "and columns."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:565
msgid ""
"56 - ATSPI_ROLE_TABLE_CELL: A \\'cell\\' or discrete child within a Table. "
"Note:"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:567
msgid ""
"Table cells need not have ATSPI_ROLE_TABLE_CELL, other role values   are "
"valid as well."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:570
msgid ""
"57 - ATSPI_ROLE_TABLE_COLUMN_HEADER: An object which labels a particular "
"column"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:572
msgid "in a Table interface interface."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:574
msgid ""
"58 - ATSPI_ROLE_TABLE_ROW_HEADER: An object which labels a particular row in "
"a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:576
msgid ""
"Table interface. Table rows and columns may also be labelled via the   "
"ATSPI_RELATION_LABEL_FOR/ATSPI_RELATION_LABELLED_BY relationships;   see the "
"GetRelationSet method."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:580
msgid ""
"59 - ATSPI_ROLE_TEAROFF_MENU_ITEM: Object allows menu to be removed from "
"menubar"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:582
msgid "and shown in its own window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:584
msgid "60 - ATSPI_ROLE_TERMINAL: An object that emulates a terminal."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:586
msgid ""
"61 - ATSPI_ROLE_TEXT: An interactive widget that supports multiple lines of "
"text"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:588
msgid ""
"and optionally accepts user input, but whose purpose is not to   solicit "
"user input. Thus ATSPI_ROLE_TEXT is appropriate for the text   view in a "
"plain text editor but inappropriate for an input field in   a dialog box or "
"web form. For widgets whose purpose is to solicit   input from the user, see "
"ATSPI_ROLE_ENTRY and   ATSPI_ROLE_PASSWORD_TEXT. For generic objects which "
"display a brief   amount of textual information, see ATSPI_ROLE_STATIC."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:596
msgid ""
"62 - ATSPI_ROLE_TOGGLE_BUTTON: A specialized push button that can be checked "
"or"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:598
msgid ""
"unchecked, but does not procide a separate indicator for the current   state."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:601
msgid ""
"63 - ATSPI_ROLE_TOOL_BAR: A bar or palette usually composed of push buttons "
"or"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:603
msgid "toggle buttons."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:605
msgid ""
"64 - ATSPI_ROLE_TOOL_TIP: An object that provides information about another"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:609
msgid ""
"65 - ATSPI_ROLE_TREE: An object used to repsent hierarchical information to "
"the"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:611
msgid "user."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:613
msgid "66 - ATSPI_ROLE_TREE_TABLE: An object that presents both tabular and"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:615
msgid "hierarchical info to the user."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:617
msgid ""
"67 - ATSPI_ROLE_UNKNOWN: The object contains some accessible information,"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:619
msgid "but its role is not known."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:621
msgid ""
"68 - ATSPI_ROLE_VIEWPORT: An object usually used in a scroll pane, or to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:623
msgid ""
"otherwise clip a larger object or content renderer to a specific   onscreen "
"viewport."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:626
msgid "69 - ATSPI_ROLE_WINDOW: A top level window with no title or border."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:628
msgid ""
"70 - ATSPI_ROLE_EXTENDED: means that the role for this item is known, but not"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:630
msgid "included in the core enumeration. Deprecated since 2.24."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:632
msgid "71 - ATSPI_ROLE_HEADER: An object that serves as a document header."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:634
msgid "72 - ATSPI_ROLE_FOOTER: An object that serves as a document footer."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:636
msgid ""
"73 - ATSPI_ROLE_PARAGRAPH: An object which is contains a single paragraph of"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:638
msgid "text content. See also ATSPI_ROLE_TEXT."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:640
msgid ""
"74 - ATSPI_ROLE_RULER: An object which describes margins and tab stops, etc."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:642
msgid ""
"for text objects which it controls (should have   "
"ATSPI_RELATION_CONTROLLER_FOR relation to such)."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:645
msgid ""
"75 - ATSPI_ROLE_APPLICATION: An object corresponding to the toplevel "
"accessible"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:647
msgid ""
"of an application, which may contain ATSPI_ROLE_FRAME objects or   other "
"accessible objects. Children of objects with the   ATSPI_ROLE_DESKTOP_FRAME "
"role are generally ATSPI_ROLE_APPLICATION   objects."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:652
msgid ""
"76 - ATSPI_ROLE_AUTOCOMPLETE: The object is a dialog or list containing items"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:654
msgid ""
"for insertion into an entry widget, for instance a list of words for   "
"completion of a text entry."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:657
msgid ""
"77 - ATSPI_ROLE_EDITBAR: The object is an editable text object in a toolbar."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:660
msgid ""
"78 - ATSPI_ROLE_EMBEDDED: The object is an embedded component container. This"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:662
msgid ""
"role is a \\\"grouping\\\" hint that the contained objects share a   context "
"which is different from the container in which this   accessible is "
"embedded. In particular, it is used for some kinds of   document embedding, "
"and for embedding of out-of-process component,   \\\"panel applets\\\", etc."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:668
msgid ""
"79 - ATSPI_ROLE_ENTRY: The object is a component whose textual content may be"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:670
msgid ""
"entered or modified by the user, provided ATSPI_STATE_EDITABLE is   present. "
"A readonly ATSPI_ROLE_ENTRY object (i.e. where   ATSPI_STATE_EDITABLE is not "
"present) implies a read-only \\'text   field\\' in a form, as opposed to a "
"title, label, or caption."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:675
msgid ""
"80 - ATSPI_ROLE_CHART: The object is a graphical depiction of quantitative "
"data."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:677
msgid ""
"It may contain multiple subelements whose attributes and/or   description "
"may be queried to obtain both the quantitative data and   information about "
"how the data is being presented. The   ATSPI_LABELLED_BY relation is "
"particularly important in interpreting   objects of this type, as is the "
"accessible description property. See   ATSPI_ROLE_CAPTION."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:684
msgid ""
"81 - ATSPI_ROLE_CAPTION: The object contains descriptive information, usually"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:686
msgid ""
"textual, about another user interface element such as a table,   chart, or "
"image."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:689
msgid ""
"82 - ATSPI_ROLE_DOCUMENT_FRAME: The object is a visual frame or container "
"which"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:691
msgid ""
"contains a view of document content. Document frames may occur   within "
"another Document instance, in which case the second document   may be said "
"to be embedded in the containing instance. HTML frames   are often "
"ATSPI_ROLE_DOCUMENT_FRAME: Either this object, or a   singleton descendant, "
"should implement the org.a11y.atspi.Document   interface."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:698
msgid ""
"83 - ATSPI_ROLE_HEADING: The object serves as a heading for content which"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:700
msgid ""
"follows it in a document. The \\'heading level\\' of the heading, if   "
"availabe, may be obtained by querying the object\\'s attributes."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:703
msgid ""
"84 - ATSPI_ROLE_PAGE: The object is a containing instance which encapsulates "
"a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:705
msgid ""
"page of information. ATSPI_ROLE_PAGE is used in documents and   content "
"which support a paginated navigation model."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:708
msgid ""
"85 - ATSPI_ROLE_SECTION: The object is a containing instance of document "
"content"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:710
msgid ""
"which constitutes a particular \\'logical\\' section of the document.   The "
"type of content within a section, and the nature of the section   division "
"itself, may be obtained by querying the object\\'s   attributes. Sections "
"may be nested."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:715
msgid ""
"86 - ATSPI_ROLE_REDUNDANT_OBJECT: The object is redundant with another "
"object in"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:717
msgid ""
"the hierarchy, and is exposed for purely technical reasons. Objects   of "
"this role should be ignored by clients, if they are encountered   at all."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:721
msgid ""
"87 - ATSPI_ROLE_FORM: The object is a containing instance of document content"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:723
msgid ""
"which has within it components with which the user can interact in   order "
"to input information; i.e. the object is a container for   pushbuttons, "
"comboboxes, text input fields, and other \\'GUI\\'   components. "
"ATSPI_ROLE_FORM should not, in general, be used for   toplevel GUI "
"containers or dialogs, but should be reserved for   \\'GUI\\' containers "
"which occur within document content, for instance   within Web documents, "
"presentations, or text documents. Unlike other   GUI containers and dialogs "
"which occur inside application instances,   ATSPI_ROLE_FORM containers\\' "
"components are associated with the   current document, rather than the "
"current foreground application or   viewer instance."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:735
msgid ""
"88 - ATSPI_ROLE_LINK: The object is a hypertext anchor, i.e. a \\\"link\\\" "
"in a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:737
msgid ""
"hypertext document. Such objects are distinct from \\'inline\\'   content "
"which may also use the Hypertext/Hyperlink interfaces to   indicate the "
"range/location within a text object where an inline or   embedded object "
"lies."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:742
msgid ""
"89 - ATSPI_ROLE_INPUT_METHOD_WINDOW: The object is a window or similar "
"viewport"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:744
msgid ""
"which is used to allow composition or input of a \\'complex   character\\', "
"in other words it is an \\\"input method window\\\"."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:747
msgid "90 - ATSPI_ROLE_TABLE_ROW: A row in a table."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:749
msgid ""
"91 - ATSPI_ROLE_TREE_ITEM: An object that represents an element of a tree."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:752
msgid "92 - ATSPI_ROLE_DOCUMENT_SPREADSHEET: A document frame which contains a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:754
msgid "spreadsheet."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:756
msgid ""
"93 - ATSPI_ROLE_DOCUMENT_PRESENTATION: A document frame which contains a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:758
msgid "presentation or slide content."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:760
msgid ""
"94 - ATSPI_ROLE_DOCUMENT_TEXT: A document frame which contains textual "
"content,"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:762
msgid "such as found in a word processing application."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:764
msgid ""
"95 - ATSPI_ROLE_DOCUMENT_WEB: A document frame which contains HTML or other"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:766
msgid "markup suitable for display in a web browser."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:768
msgid ""
"96 - ATSPI_ROLE_DOCUMENT_EMAIL: A document frame which contains email content"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:770
msgid "to be displayed or composed either in plain text or HTML."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:772
msgid ""
"97 - ATSPI_ROLE_COMMENT: An object found within a document and designed to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:774
msgid ""
"present a comment, note, or other annotation. In some cases, this   object "
"might not be visible until activated."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:777
msgid ""
"98 - ATSPI_ROLE_LIST_BOX: A non-collapsible list of choices the user can "
"select from."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:780
msgid ""
"99 - ATSPI_ROLE_GROUPING: A group of related widgets. This group typically "
"has a label."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:783
msgid ""
"100 - ATSPI_ROLE_IMAGE_MAP: An image map object. Usually a graphic with "
"multiple"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:785
msgid ""
"hotspots, where each hotspot can be activated resulting in the   loading of "
"another document or section of a document."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:788
msgid ""
"101 - ATSPI_ROLE_NOTIFICATION: A transitory object designed to present a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:790
msgid ""
"message to the user, typically at the desktop level rather than   inside a "
"particular application."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:793
msgid ""
"102 - ATSPI_ROLE_INFO_BAR: An object designed to present a message to the "
"user"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:795
msgid "within an existing window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:797
msgid ""
"103 - ATSPI_ROLE_LEVEL_BAR: A bar that serves as a level indicator to, for"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:799
msgid ""
"instance, show the strength of a password or the state of a battery.   "
"Since: 2.8"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:802
msgid ""
"104 - ATSPI_ROLE_TITLE_BAR: A bar that serves as the title of a window or a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:804
msgid "dialog. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:806
msgid "105 - ATSPI_ROLE_BLOCK_QUOTE: An object which contains a text section"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:808
msgid "that is quoted from another source. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:810
msgid "106 - ATSPI_ROLE_AUDIO: An object which represents an audio"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:812
#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:816
msgid "element. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:814
msgid "107 - ATSPI_ROLE_VIDEO: An object which represents a video"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:818
msgid ""
"108 - ATSPI_ROLE_DEFINITION: A definition of a term or concept. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:821
msgid "109 - ATSPI_ROLE_ARTICLE: A section of a page that consists of a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:823
msgid ""
"composition that forms an independent part of a document, page, or   site. "
"Examples: A blog entry, a news story, a forum post. Since:   2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:827
msgid "110 - ATSPI_ROLE_LANDMARK: A region of a web page intended as a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:829
msgid ""
"navigational landmark. This is designed to allow Assistive   Technologies to "
"provide quick navigation among key regions within a   document. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:833
msgid ""
"111 - ATSPI_ROLE_LOG: A text widget or container holding log content, such"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:835
msgid ""
"as chat history and error logs. In this role there is a relationship   "
"between the arrival of new items in the log and the reading order.   The log "
"contains a meaningful sequence and new information is added   only to the "
"end of the log, not at arbitrary points. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:840
msgid "112 - ATSPI_ROLE_MARQUEE: A container where non-essential information"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:842
msgid ""
"changes frequently. Common usages of marquee include stock tickers   and ad "
"banners. The primary difference between a marquee and a log   is that logs "
"usually have a meaningful order or sequence of   important content changes. "
"Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:847
msgid ""
"113 - ATSPI_ROLE_MATH: A text widget or container that holds a mathematical"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:849
msgid "expression. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:851
msgid "114 - ATSPI_ROLE_RATING: A widget whose purpose is to display a rating,"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:853
msgid ""
"such as the number of stars associated with a song in a media   player. "
"Objects of this role should also implement the Value   interface. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:857
msgid "115 - ATSPI_ROLE_TIMER: An object containing a numerical counter which"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:859
msgid ""
"indicates an amount of elapsed time from a start point, or the time   "
"remaining until an end point. Since: 2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:862
msgid ""
"116 - ATSPI_ROLE_STATIC: A generic non-container object whose purpose is to "
"display"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:864
msgid ""
"a brief amount of information to the user and whose role is known by   the "
"implementor but lacks semantic value for the user. Examples in   which "
"ATSPI_ROLE_STATIC is appropriate include the message displayed   in a "
"message box and an image used as an alternative means to   display text. "
"ATSPI_ROLE_STATIC should not be applied to widgets   which are traditionally "
"interactive, objects which display a   significant amount of content, or any "
"object which has an accessible   relation pointing to another object. The "
"displayed information, as a   general rule, should be exposed through the "
"accessible name of the   object. For labels which describe another widget, "
"see   ATSPI_ROLE_LABEL. For text views, see ATSPI_ROLE_TEXT. For generic   "
"containers, see ATSPI_ROLE_PANEL. For objects whose role is not   known by "
"the implementor, see ATSPI_ROLE_UNKNOWN. Since: 2.16."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:878
msgid ""
"117 - ATSPI_ROLE_MATH_FRACTION: An object that represents a mathematical "
"fraction. Since: 2.16."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:881
msgid ""
"118 - ATSPI_ROLE_MATH_ROOT: An object that represents a mathematical "
"expression"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:883
msgid "displayed with a radical. Since: 2.16."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:885
msgid ""
"119 - ATSPI_ROLE_SUBSCRIPT: An object that contains text that is displayed "
"as a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:887
msgid "subscript. Since: 2.16."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:889
msgid ""
"120 - ATSPI_ROLE_SUPERSCRIPT: An object that contains text that is displayed "
"as a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:891
msgid "superscript. Since: 2.16."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:893
msgid ""
"121 - ATSPI_ROLE_DESCRIPTION_LIST: An object that represents a list of term-"
"value"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:895
msgid ""
"groups. A term-value group represents an individual description and   "
"consist of one or more names (ATSPI_ROLE_DESCRIPTION_TERM) followed   by one "
"or more values (ATSPI_ROLE_DESCRIPTION_VALUE). For each list,   there should "
"not be more than one group with the same term name.   Since: 2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:901
msgid ""
"122 - ATSPI_ROLE_DESCRIPTION_TERM: An object that represents a term or phrase"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:903
msgid "with a corresponding definition. Since: 2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:905
msgid ""
"123 - ATSPI_ROLE_DESCRIPTION_VALUE: An object that represents the "
"description,"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:907
msgid "definition, or value of a term. Since: 2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:909
msgid ""
"124 - ATSPI_ROLE_FOOTNOTE: An object that contains the text of a footnote. "
"Since: 2.26."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:912
msgid ""
"125 - ATSPI_ROLE_CONTENT_DELETION: Content previously deleted or proposed to "
"be"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:914
msgid ""
"deleted, e.g. in revision history or a content view providing   suggestions "
"from reviewers. Since: 2.34."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:917
msgid ""
"126 - ATSPI_ROLE_CONTENT_INSERTION: Content previously inserted or proposed "
"to be"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:919
msgid ""
"inserted, e.g. in revision history or a content view providing   suggestions "
"from reviewers. Since: 2.34."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:922
msgid ""
"127 - ATSPI_ROLE_MARK: A run of content that is marked or highlighted, such "
"as for"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:924
msgid ""
"reference purposes, or to call it out as having a special purpose.   If the "
"marked content has an associated section in the document   elaborating on "
"the reason for the mark, then an   ATSPI_RELATION_DETAILS relation should be "
"used on the mark to point   to that associated section. In addition, the "
"reciprocal relation   ATSPI_RELATION_DETAILS_FOR should be used on the "
"associated content   section to point back to the mark. See the "
"GetRelationSet method.   Since: 2.36."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:933
msgid ""
"128 - ATSPI_ROLE_SUGGESTION: A container for content that is called out as a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:935
msgid ""
"proposed change from the current version of the document, such as by   a "
"reviewer of the content. An object with this role should include   children "
"with ATSPI_ROLE_CONTENT_DELETION and/or   ATSPI_ROLE_CONTENT_INSERTION, in "
"any order, to indicate what the   actual change is. Since: 2.36"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:941
msgid ""
"129 - ATSPI_ROLE_PUSH_BUTTON_MENU: A specialized push button to open a menu. "
"Since: 2.46"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:944
msgid ""
"130 - ATSPI_ROLE_SWITCH: A switch that can be toggled on/off. Since: 2.56"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:947
msgid "org.a11y.atspi.Accessible.GetRoleName"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:951
msgid ""
"GetRoleName (\n"
"  OUT unnamed_arg0 s\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:957
msgid ""
"Gets a UTF-8 string corresponding to the name of the role played by an "
"object. This method will return useful values for roles that fall outside "
"the enumeration used in the GetRole method. Implementing this method is "
"optional, and it may be removed in a future version of the API. Libatspi "
"will only call id in the event of an unknown role."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:963
msgid "org.a11y.atspi.Accessible.GetLocalizedRoleName"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:967
msgid ""
"GetLocalizedRoleName (\n"
"  OUT unnamed_arg0 s\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:973
msgid ""
"Gets a UTF-8 string corresponding to the name of the role played by an "
"object, translated to the current locale. This method will return useful "
"values for roles that fall outside the enumeration used in the GetRole "
"method. Implementing this method is optional, and it may be removed in a "
"future version of the API. Libatspi will only call id in the event of an "
"unknown role."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:980
msgid "org.a11y.atspi.Accessible.GetState"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:984
msgid ""
"GetState (\n"
"  OUT unnamed_arg0 au\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:990
msgid "Gets the set of states currently held by an object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:994
msgid ""
"Elements in the array are enumeration values from AtspiStateType in atspi-"
"constants.h:"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:997
msgid "0 - ATSPI_STATE_INVALID: Indicates an invalid state - probably an error"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:999
msgid "condition."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1001
msgid ""
"1 - ATSPI_STATE_ACTIVE: Indicates a window is currently the active window, or"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1003
msgid ""
"an object is the active subelement within a container or table.   "
"ATSPI_STATE_ACTIVE should not be used for objects which have   "
"ATSPI_STATE_FOCUSABLE or ATSPI_STATE_SELECTABLE: Those objects   should use "
"ATSPI_STATE_FOCUSED and ATSPI_STATE_SELECTED   respectively. "
"ATSPI_STATE_ACTIVE is a means to indicate that an   object which is not "
"focusable and not selectable is the   currently-active item within its "
"parent container."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1011
msgid "2 - ATSPI_STATE_ARMED: Indicates that the object is armed."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1013
msgid ""
"3 - ATSPI_STATE_BUSY: Indicates the current object is busy, i.e. onscreen"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1015
msgid ""
"representation is in the process of changing, or the object is   temporarily "
"unavailable for interaction due to activity already in   progress."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1019
msgid "4 - ATSPI_STATE_CHECKED: Indicates this object is currently checked."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1021
msgid "5 - ATSPI_STATE_COLLAPSED: Indicates this object is collapsed."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1023
msgid ""
"6 - ATSPI_STATE_DEFUNCT: Indicates that this object no longer has a valid"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1025
msgid "backing widget (for instance, if its peer object has been   destroyed)."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1028
msgid ""
"7 - ATSPI_STATE_EDITABLE: Indicates the user can change the contents of this"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1032
msgid ""
"8 - ATSPI_STATE_ENABLED: Indicates that this object is enabled, i.e. that it"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1034
msgid ""
"currently reflects some application state. Objects that are \\\"greyed   "
"out\\\" may lack this state, and may lack the ATSPI_STATE_SENSITIVE if   "
"direct user interaction cannot cause them to acquire   ATSPI_STATE_ENABLED. "
"See ATSPI_STATE_SENSITIVE."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1039
msgid "9 - ATSPI_STATE_EXPANDABLE: Indicates this object allows progressive"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1041
msgid "disclosure of its children."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1043
msgid "10 - ATSPI_STATE_EXPANDED: Indicates this object is expanded."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1045
msgid ""
"11 - ATSPI_STATE_FOCUSABLE: Indicates this object can accept keyboard focus,"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1047
msgid ""
"which means all events resulting from typing on the keyboard will   normally "
"be passed to it when it has focus."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1050
msgid ""
"12 - ATSPI_STATE_FOCUSED: Indicates this object currently has the keyboard"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1052
msgid "focus."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1054
msgid ""
"13 - ATSPI_STATE_HAS_TOOLTIP: Indicates that the object has an associated"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1056
msgid "tooltip."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1058
msgid ""
"14 - ATSPI_STATE_HORIZONTAL: Indicates the orientation of this object is"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1060
msgid "horizontal."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1062
msgid "15 - ATSPI_STATE_ICONIFIED: Indicates this object is minimized and is"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1064
msgid "represented only by an icon."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1066
msgid ""
"16 - ATSPI_STATE_MODAL: Indicates something must be done with this object"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1068
msgid "before the user can interact with an object in a different window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1070
msgid ""
"17 - ATSPI_STATE_MULTI_LINE: Indicates this (text) object can contain "
"multiple"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1072
msgid "lines of text."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1074
msgid ""
"18 - ATSPI_STATE_MULTISELECTABLE: Indicates this object allows more than one "
"of"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1076
msgid ""
"its children to be selected at the same time, or in the case of text   "
"objects, that the object supports non-contiguous text selections."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1079
msgid ""
"19 - ATSPI_STATE_OPAQUE: Indicates this object paints every pixel within its"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1081
msgid ""
"rectangular region. It also indicates an alpha value of unity, if it   "
"supports alpha blending."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1084
msgid "20 - ATSPI_STATE_PRESSED: Indicates this object is currently pressed."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1086
msgid ""
"21 - ATSPI_STATE_RESIZABLE: Indicates the size of this object\\'s size is not"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1088
msgid "fixed."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1090
msgid ""
"22 - ATSPI_STATE_SELECTABLE: Indicates this object is the child of an object"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1092
msgid ""
"that allows its children to be selected and that this child is one   of "
"those children that can be selected."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1095
msgid ""
"23 - ATSPI_STATE_SELECTED: Indicates this object is the child of an object "
"that"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1097
msgid ""
"allows its children to be selected and that this child is one of   those "
"children that has been selected."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1100
msgid ""
"24 - ATSPI_STATE_SENSITIVE: Indicates this object is sensitive, e.g. to user"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1102
msgid ""
"interaction. ATSPI_STATE_SENSITIVE usually accompanies.   "
"ATSPI_STATE_ENABLED for user-actionable controls, but may be found   in the "
"absence of ATSPI_STATE_ENABLED if the current visible state   of the control "
"is \\\"disconnected\\\" from the application state. In   such cases, direct "
"user interaction can often result in the object   gaining "
"ATSPI_STATE_SENSITIVE, for instance if a user makes an   explicit selection "
"using an object whose current state is ambiguous   or undefined. See "
"ATSPI_STATE_ENABLED, ATSPI_STATE_INDETERMINATE."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1111
msgid ""
"25 - ATSPI_STATE_SHOWING: Indicates this object, the object\\'s parent, the"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1113
msgid ""
"object\\'s parent\\'s parent, and so on, are all \\'shown\\' to the   end-"
"user, i.e. subject to \\\"exposure\\\" if blocking or obscuring   objects do "
"not interpose between this object and the top of the   window stack."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1118
msgid ""
"26 - ATSPI_STATE_SINGLE_LINE: Indicates this (text) object can contain only a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1120
msgid "single line of text."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1122
msgid ""
"27 - ATSPI_STATE_STALE: Indicates that the information returned for this "
"object"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1124
msgid ""
"may no longer be synchronized with the application state. This can   occur "
"if the object has ATSPI_STATE_TRANSIENT, and can also occur   towards the "
"end of the object peer\\'s lifecycle."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1128
msgid "28 - ATSPI_STATE_TRANSIENT: Indicates this object is transient."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1130
msgid ""
"29 - ATSPI_STATE_VERTICAL: Indicates the orientation of this object is "
"vertical;"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1132
msgid ""
"for example this state may appear on such objects as scrollbars,   text "
"objects (with vertical text flow), separators, etc."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1135
msgid ""
"30 - ATSPI_STATE_VISIBLE: Indicates this object is visible, e.g. has been"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1137
msgid ""
"explicitly marked for exposure to the user. ATSPI_STATE_VISIBLE is   no "
"guarantee that the object is actually unobscured on the screen,   only that "
"it is \\'potentially\\' visible, barring obstruction, being   scrolled or "
"clipped out of the field of view, or having an ancestor   container that has "
"not yet made visible. A widget is potentially   onscreen if it has both "
"ATSPI_STATE_VISIBLE and ATSPI_STATE_SHOWING.   The absence of "
"ATSPI_STATE_VISIBLE and ATSPI_STATE_SHOWING is   semantically equivalent to "
"saying that an object is \\'hidden\\'."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1146
msgid ""
"31 - ATSPI_STATE_MANAGES_DESCENDANTS: Indicates that \\\"active-descendant-"
"changed\\\""
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1148
msgid ""
"event is sent when children become \\'active\\' (i.e. are selected or   "
"navigated to onscreen). Used to prevent need to enumerate all   children in "
"very large containers, like tables. The presence of   "
"ATSPI_STATE_MANAGES_DESCENDANTS is an indication to the client that   the "
"children should not, and need not, be enumerated by the client.   Objects "
"implementing this state are expected to provide relevant   state "
"notifications to listening clients, for instance notifications   of "
"visibility changes and activation of their contained child   objects, "
"without the client having previously requested references   to those "
"children."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1159
msgid ""
"32 - ATSPI_STATE_INDETERMINATE: Indicates that a check box or other boolean"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1161
msgid ""
"indicator is in a state other than checked or not checked. This   usually "
"means that the boolean value reflected or controlled by the   object does "
"not apply consistently to the entire current context.   For example, a "
"checkbox for the \\\"Bold\\\" attribute of text may have   "
"ATSPI_STATE_INDETERMINATE if the currently selected text contains a   "
"mixture of weight attributes. In many cases interacting with a   "
"ATSPI_STATE_INDETERMINATE object will cause the context\\'s   corresponding "
"boolean attribute to be homogenized, whereupon the   object will lose "
"ATSPI_STATE_INDETERMINATE and a corresponding   state-changed event will be "
"fired."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1172
msgid ""
"33 - ATSPI_STATE_REQUIRED: Indicates that user interaction with this object "
"is"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1174
msgid ""
"\\'required\\' from the user, for instance before completing the   "
"processing of a form."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1177
msgid ""
"34 - ATSPI_STATE_TRUNCATED: Indicates that an object\\'s onscreen content"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1179
msgid "is truncated, e.g. a text value in a spreadsheet cell."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1181
msgid ""
"35 - ATSPI_STATE_ANIMATED: Indicates this object\\'s visual representation is"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1183
msgid ""
"dynamic, not static. This state may be applied to an object during   an "
"animated \\'effect\\' and be removed from the object once its   visual "
"representation becomes static. Some applications, notably   content viewers, "
"may not be able to detect all kinds of animated   content. Therefore the "
"absence of this state should not be taken as   definitive evidence that the "
"object\\'s visual representation is   static; this state is advisory."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1191
msgid ""
"36 - ATSPI_STATE_INVALID_ENTRY: This object has indicated an error condition"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1193
msgid ""
"due to failure of input validation. For instance, a form control may   "
"acquire this state in response to invalid or malformed user input."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1196
msgid ""
"37 - ATSPI_STATE_SUPPORTS_AUTOCOMPLETION: This state indicates that the "
"object"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1198
msgid ""
"in question implements some form of typeahead or pre-selection   behavior "
"whereby entering the first character of one or more   sub-elements causes "
"those elements to scroll into view or become   selected. Subsequent "
"character input may narrow the selection   further as long as one or more "
"sub-elements match the string. This   state is normally only useful and "
"encountered on objects that   implement AtspiSelection. In some cases the "
"typeahead behavior may   result in full or partial completion of the data in "
"the input field,   in which case these input events may trigger text-changed "
"events   from the source."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1209
msgid ""
"38 - ATSPI_STATE_SELECTABLE_TEXT: This state indicates that the object in"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1211
msgid ""
"question supports text selection. It should only be exposed on   objects "
"which implement the AtspiText interface, in order to   distinguish this "
"state from ATSPI_STATE_SELECTABLE, which infers   that the object in "
"question is a selectable child of an object which   implements "
"AtspiSelection. While similar, text selection and   subelement selection are "
"distinct operations."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1218
msgid ""
"39 - ATSPI_STATE_IS_DEFAULT: This state indicates that the object in "
"question is"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1220
msgid ""
"the \\'default\\' interaction object in a dialog, i.e. the one that   gets "
"activated if the user presses \\\"Enter\\\" when the dialog is   initially "
"posted."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1224
msgid ""
"40 - ATSPI_STATE_VISITED: This state indicates that the object (typically a"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1226
msgid ""
"hyperlink) has already been activated or invoked, with the result   that "
"some backing data has been downloaded or rendered."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1229
msgid "41 - ATSPI_STATE_CHECKABLE: Indicates this object has the potential to"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1231
msgid "be checked, such as a checkbox or toggle-able table cell. Since:   2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1234
msgid "42 - ATSPI_STATE_HAS_POPUP: Indicates that the object has a popup"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1236
msgid ""
"context menu or sub-level menu which may or may not be showing. This   means "
"that activation renders conditional content. Note that   ordinary tooltips "
"are not considered popups in this context. Since:   2.12"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1241
msgid ""
"43 - ATSPI_STATE_READ_ONLY: Indicates that an object which is ENABLED and"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1243
msgid ""
"SENSITIVE has a value which can be read, but not modified, by the   user. "
"Since: 2.16"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1247
msgid "org.a11y.atspi.Accessible.GetAttributes"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1251
msgid ""
"GetAttributes (\n"
"  OUT unnamed_arg0 a{ss}\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1257
msgid ""
"Gets a list of name/value pairs of attributes or annotations for this "
"object. For typographic, textual, or textually-semantic attributes, see the "
"Text.GetAttributes method."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1261
msgid "org.a11y.atspi.Accessible.GetApplication"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1265
msgid ""
"GetApplication (\n"
"  OUT unnamed_arg0 (so)\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1271
msgid ""
"Returns a string for the application name, and an object path for the "
"containing application object."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1275
msgid "org.a11y.atspi.Accessible.GetInterfaces"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1279
msgid ""
"GetInterfaces (\n"
"  OUT unnamed_arg0 as\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Accessible.md:1285
msgid ""
"Returns an array of accessible interface names supported by the current "
"object."
msgstr ""
