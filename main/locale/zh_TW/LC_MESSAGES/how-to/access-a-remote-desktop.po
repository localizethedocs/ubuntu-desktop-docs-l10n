#: ../../../how-to/access-a-remote-desktop.md:0
msgid ""
"View or control another computer's desktop from Ubuntu Desktop using the "
"Remmina app over the RDP or VNC protocol."
msgstr ""

#: ../../../how-to/access-a-remote-desktop.md:8
msgid "Topics: Remote access Windows macOS"
msgstr ""

#: ../../../how-to/access-a-remote-desktop.md:12
msgid "Access a remote desktop"
msgstr ""

#: ../../../how-to/access-a-remote-desktop.md:14
msgid ""
"<!--\n"
"Original tutorial: <https://discourse.ubuntu.com/t/access-a-remote-desktop/"
"13965>\n"
"Original author: Nicole Mikołajczyk <me@m4sk.in>\n"
"\n"
"Related test plan: <https://wiki.ubuntu.com/DesktopTeam/TestPlans/"
"RemoteDesktop>\n"
