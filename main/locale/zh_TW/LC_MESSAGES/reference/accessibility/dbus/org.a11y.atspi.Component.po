#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:392
msgid "The `type` corresponds to AtkScrollType:"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:394
msgid ""
"0 - TOP_LEFT: Scroll the object vertically and horizontally to bring its top "
"left corner to the top left corner of the window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:397
msgid ""
"1 - BOTTOM_RIGHT: Scroll the object vertically and horizontally to bring its "
"bottom right corner to the bottom right corner of the window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:400
msgid ""
"2 - TOP_EDGE: Scroll the object vertically to bring its top edge to the top "
"edge of the window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:403
msgid ""
"3 - BOTTOM_EDGE: Scroll the object vertically to bring its bottom edge to "
"the bottom edge of the window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:406
msgid ""
"4 - LEFT_EDGE: Scroll the object vertically and horizontally to bring its "
"left edge to the left edge of the window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:409
msgid ""
"5 - RIGHT_EDGE: Scroll the object vertically and horizontally to bring its "
"right edge to the right edge of the window."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Component.md:412
msgid ""
"6 - ANYWHERE: Scroll the object vertically and horizontally so that as much "
"as possible of the object becomes visible. The exact placement is determined "
"by the application."
msgstr ""

