#: ../../../reference/accessibility/dbus/org.a11y.atspi.Action.md:1
msgid "org.a11y.atspi.Action"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Action.md:3
msgid "Description"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Action.md:5
msgid ""
"Allows exploring and invoking the actions of a user-actionable UI component."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Action.md:8
msgid ""
"For example, a button may expose a \\\"click\\\" action; a popup menu may "
"expose an \\\"open\\\" action. Components which are not \\\"passive\\\" "
"providers of UI information should implement this interface, unless there is "
"a more specialized interface for interaction like org.a11y.atspi.Text or "
"org.a11y.atspi.Value."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.Action.md:14
msgid "Properties"
msgstr ""

