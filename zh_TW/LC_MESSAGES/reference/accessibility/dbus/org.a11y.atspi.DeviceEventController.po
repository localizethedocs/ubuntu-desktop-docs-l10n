msgid "array of (key_code, key_sym, key_string, unused)"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:60
#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:90
msgid "mask"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:62
msgid "modifier mask in X11 style (see Xlib.h)"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:64
msgid "types"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:66
msgid "mask of press/release; see the description below."
msgstr ""

