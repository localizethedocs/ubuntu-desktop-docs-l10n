msgid "org.a11y.atspi.DeviceEventController"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:3
msgid "Description"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:5
msgid ""
"Legacy interface for keystroke listeners and generation of keyboard/mouse "
"events"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:8
msgid ""
"This interface is being replaced by the functions in atspi-device-listener.h."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:11
msgid "Methods"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:13
msgid "org.a11y.atspi.DeviceEventController.RegisterKeystrokeListener"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:17
msgid ""
"RegisterKeystrokeListener (\n"
"  IN listener o,\n"
"  IN keys a(iisi),\n"
"  IN mask u,\n"
"  IN types u,\n"
"  IN mode (bbb),\n"
"  OUT unnamed_arg5 b\n"
")\n"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:26
msgid "The `types` can be a mask of the following:"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:28
msgid "KEY_PRESS = 1 \\<\\< 0"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:29
msgid "KEY_RELEASE = 1 \\<\\< 1"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:31
msgid "Note that Orca always passes (KEY_PRESS \\| KEY_RELEASE)."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:33
msgid "The `mode` is composed of three flags (see AtspiKeyListenerSyncType):"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:35
msgid ""
"synchronous: Events are delivered synchronously, before the currently "
"focused application sees them. If false, events may be delivered "
"asynchronously, which means in some cases they may already have been "
"delivered to the application before the AT client receives the notification."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:40
msgid ""
"preemptive: (called CANCONSUME in AtspiKeyListenerSyncType) Events may be "
"consumed by the AT client. Requires the synchronous flag to be set."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:43
msgid ""
"global: (called ALL_WINDOWS in AtspiKeyListenerSyncType) Events are received "
"not from the application toolkit layer, but from the device driver or "
"windowing system subsystem."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:47
msgid ""
"Returns: boolean indicating whether the operation was successful. This is "
"always TRUE for non-global listeners (c.f. `mode`), and may be FALSE for "
"global listeners if the underlying XGrabKey() failed (see "
"spi_dec_x11_grab_key)."
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:52
#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:86
msgid "listener"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:54
msgid "path of object to be notified when the following keys are pressed"
msgstr ""

#: ../../../reference/accessibility/dbus/org.a11y.atspi.DeviceEventController.md:56
